{
  "compilerOptions": {
    "strict": true,
    // Two checks `strict` does not include, both measured at zero errors before being turned on
    // (2026-08-20). They are here to stay that way: a function that returns a value on some
    // paths and falls off the end on others, and a `case` that runs into the next one, are
    // mistakes this codebase has no use for and no existing instance of.
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    // An optional field must be ABSENT, not present holding `undefined`. This codebase already
    // depended on that distinction and maintained it by hand — stophook.ts's withLastStop
    // explains why at length: a test comparing a written record against a literal without the
    // key sees two different shapes otherwise. Enforced here rather than remembered.
    "exactOptionalPropertyTypes": true,
    "target": "es2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "types": ["node"]
  },
  "include": ["src", "tests"]
}
