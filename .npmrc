# In the repository rather than only in ~/.npmrc, so a clone and CI both get it.
#
# ignore-scripts also stops npm's OWN pre/post lifecycle hooks, `prepublishOnly`
# included. The release checklist and the publish workflow run those steps
# themselves — see docs/maintenance.md and docs/releasing.md.
ignore-scripts=true

# Install nothing published in the last week. A compromised release is usually
# found and pulled within days, so waiting is the defence.
min-release-age=7
